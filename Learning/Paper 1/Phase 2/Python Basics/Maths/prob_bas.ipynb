     "name": "stdout",
     "output_type": "stream",
     "text": [
      "50.0\n",
      "66.66666666666666\n"
     ]
    }
   ],
   "source": [
    "evn_out = len(evn)\n",
    "prob_evn = evn_out / pos_out\n",
    "print(prob_evn * 100)\n",
    "\n",
    "prob_gt2 = len(gt2) / pos_out\n",
    "print(prob_gt2 * 100)"
   ]
  },
