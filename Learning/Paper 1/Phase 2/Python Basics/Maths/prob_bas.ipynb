   "source": [
    "sample_space = [1,2,3,4,5,6]\n",
    "\n",
    "evn = [x for x in sample_space if x%2 ==0]\n",
    "gt2 = [x for x in sample_space if x > 2 ]\n",
    "\n",
    "pos_out = len(sample_space)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "8c2836a2",
   "metadata": {},
   "outputs": [
