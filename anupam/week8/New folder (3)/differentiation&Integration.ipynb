   "source": [
    "from sympy import symbols,diff,integrate"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "caf6cea4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "2*x\n"
     ]
    }
   ],
   "source": [
    "x=symbols('x')\n",
    "\n",
    "f=x**2\n",
    "\n",
    "dfdx=diff(f,x)\n",
    "\n",
    "print(dfdx)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "a69e9bd8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "y**3/3\n"
     ]
    }
   ],
   "source": [
    "y=symbols('y')\n",
    "\n",
    "f=y**2\n",
    "\n",
    "integral= integrate(f,y)\n",
    "\n",
    "print(integral)"
   ]
